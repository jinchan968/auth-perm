# ==============================================================================
# Auth-Perm 应用环境变量配置模板
# ==============================================================================
# 使用说明：
# 1. 复制此文件为 .env: cp .env.sample .env
# 2. 根据实际情况修改配置值
# 3. 重要：请勿将包含真实密码的 .env 文件提交到版本控制系统

# ==============================================================================
# 服务器配置
# ==============================================================================
# 服务器监听地址
SERVER_HOST=localhost

# 服务器监听端口
SERVER_PORT=8080

# Gin框架模式 (debug/release/test)
GIN_MODE=debug

# ==============================================================================
# 数据库配置
# ==============================================================================
# 数据库主机
DB_HOST=localhost

# 数据库端口
DB_PORT=5432

# 数据库用户名
DB_USER=auth_perm

# 数据库密码
DB_PASSWORD=your_secure_password_here

# 数据库名称
DB_NAME=auth_perm

# SSL模式 (disable/require/verify-ca)
DB_SSLMODE=disable

# 连接池配置
DB_MAX_IDLE_CONNS=10
DB_MAX_OPEN_CONNS=100

# ==============================================================================
# Redis配置
# ==============================================================================
# Redis主机
REDIS_HOST=localhost

# Redis端口
REDIS_PORT=6379

# Redis密码（无密码则留空）
REDIS_PASSWORD=

# Redis数据库编号
REDIS_DB=0

# 连接池大小
REDIS_POOL_SIZE=10

# ==============================================================================
# 令牌和会话配置
# ==============================================================================
# 令牌密钥（用于Token签名，请设置复杂且保密的密钥）
TOKEN_SECRET=your_very_long_and_complex_secret_key_here_at_least_32_characters

# 令牌过期时间
TOKEN_EXPIRES_IN=24h

# 会话密钥（用于Session签名，请设置复杂且保密的密钥）
SESSION_SECRET=your_very_long_and_complex_session_secret_here_at_least_32_characters

# 会话过期时间
SESSION_EXPIRES_IN=168h

# Cookie安全设置（生产环境建议设置为true）
COOKIE_SECURE=false
COOKIE_HTTP_ONLY=true

# ==============================================================================
# 日志配置
# ==============================================================================
# 日志级别 (debug/info/warn/error)
LOG_LEVEL=info

# 日志文件路径
LOG_FILE=logs/app.log

# 日志文件最大大小 (MB)
LOG_MAX_SIZE=100

# 日志备份文件数量
LOG_MAX_BACKUPS=3

# 日志保留天数
LOG_MAX_AGE=28

# 是否压缩备份日志
LOG_COMPRESS=true

# ==============================================================================
# 多租户配置
# ==============================================================================
# 默认租户ID
DEFAULT_TENANT_ID=default

# 是否启用多租户
ENABLE_MULTI_TENANT=true

# ==============================================================================
# OAuth第三方登录配置
# ==============================================================================
# GitHub OAuth配置
# 获取方式：https://github.com/settings/applications/new
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_REDIRECT_URL=http://localhost:8080/api/v1/auth/oauth/github/callback

# Google OAuth配置
# 获取方式：https://console.developers.google.com/
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/auth/oauth/google/callback

# 微信OAuth配置
# 获取方式：https://mp.weixin.qq.com/
WECHAT_APP_ID=your_wechat_app_id
WECHAT_APP_SECRET=your_wechat_app_secret
WECHAT_REDIRECT_URL=http://localhost:8080/api/v1/auth/oauth/wechat/callback

# ==============================================================================
# 监控和告警配置
# ==============================================================================
# 是否启用健康检查
ENABLE_HEALTH_CHECK=true

# 是否启用指标收集
ENABLE_METRICS=true

# 是否启用告警
ENABLE_ALERTING=true

# 数据库连接告警阈值
MAX_DB_CONNECTIONS=80

# Redis内存告警阈值 (MB)
MAX_REDIS_MEMORY_MB=512

# 响应时间告警阈值 (毫秒)
MAX_RESPONSE_TIME_MS=1000

# 告警Webhook URL（支持钉钉、企业微信、Slack等）
ALERT_WEBHOOK_URL=

# ==============================================================================
# 开发和测试环境配置
# ==============================================================================
# 环境标识 (development/production/testing)
ENV=development

# 是否启用详细日志
DEBUG=false

# 是否启用SQL日志
SQL_LOG=false

# ==============================================================================
# 安全配置
# ==============================================================================
# API请求速率限制（每分钟请求数）
RATE_LIMIT=100

# CORS允许的源（生产环境请设置具体域名）
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# 密码最小长度
PASSWORD_MIN_LENGTH=8

# 是否要求密码复杂度
PASSWORD_REQUIRE_COMPLEXITY=true

# ==============================================================================
# 邮件服务配置（可选）
# ==============================================================================
# SMTP服务器地址
SMTP_HOST=

# SMTP端口
SMTP_PORT=587

# SMTP用户名
SMTP_USERNAME=

# SMTP密码
SMTP_PASSWORD=

# 发件人邮箱
SMTP_FROM_EMAIL=

# 是否使用TLS
SMTP_USE_TLS=true

# ==============================================================================
# 文件存储配置（可选）
# ==============================================================================
# 文件存储类型 (local/s3/oss)
STORAGE_TYPE=local

# 本地存储路径
STORAGE_LOCAL_PATH=uploads

# AWS S3配置
AWS_S3_BUCKET=
AWS_S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# 阿里云OSS配置
OSS_BUCKET=
OSS_REGION=
OSS_ACCESS_KEY_ID=
OSS_SECRET_ACCESS_KEY=

# ==============================================================================
# 缓存配置
# ==============================================================================
# 缓存类型 (redis/memory)
CACHE_TYPE=redis

# 缓存默认过期时间
CACHE_DEFAULT_TTL=3600

# 缓存前缀
CACHE_PREFIX=auth_perm

# ==============================================================================
# 性能优化配置
# ==============================================================================
# 最大并发请求数
MAX_CONCURRENT_REQUESTS=1000

# 请求超时时间（毫秒）
REQUEST_TIMEOUT_MS=30000

# 数据库查询超时时间（毫秒）
DB_QUERY_TIMEOUT_MS=5000

# ==============================================================================
# 高级配置
# ==============================================================================
# 是否启用特性开关
ENABLE_FEATURE_FLAGS=false

# 是否启用灰度发布
ENABLE_CANARY_RELEASES=false

# 是否启用分布式追踪
ENABLE_TRACING=false

# 分布式追踪后端 (jaeger/zipkin)
TRACING_BACKEND=jaeger

# 分布式追踪地址
TRACING_ENDPOINT=

# ==============================================================================
# 注意：
# 1. 所有以 "_SECRET" 或 "_PASSWORD" 结尾的变量都是敏感信息，请妥善保管
# 2. 生产环境请务必修改所有默认密码和密钥
# 3. 生产环境请将 COOKIE_SECURE 设置为 true
# 4. 生产环境请将 GIN_MODE 设置为 release
# 5. 生产环境请设置正确的 CORS_ALLOWED_ORIGINS
# 6. 定期轮换 TOKEN_SECRET 和 SESSION_SECRET
# ==============================================================================
